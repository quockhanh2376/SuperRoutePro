{
  "name": "super-route-pro",
  "private": true,
  "version": "9.0.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "prepare:repair-sidecars": "powershell -ExecutionPolicy Bypass -File scripts/prepare-repair-sidecars.ps1",
    "check:frontend": "npm run build",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check": "npm run check:frontend && npm run check:rust",
    "version:bump": "powershell -ExecutionPolicy Bypass -File scripts/bump-version.ps1",
    "version:patch": "npm run version:bump -- patch",
    "version:minor": "npm run version:bump -- minor",
    "version:major": "npm run version:bump -- major",
    "release:ship": "powershell -ExecutionPolicy Bypass -File scripts/release-ship.ps1",
    "release:patch": "npm run release:ship -- patch",
    "release:minor": "npm run release:ship -- minor",
    "release:major": "npm run release:ship -- major",
    "release:build": "npm run tauri -- build",
    "release:local": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1",
    "preview": "vite preview",
    "tauri": "node -e \"const path=require('node:path');const {pathToFileURL}=require('node:url');const root=process.env.INIT_CWD||process.cwd();import(pathToFileURL(path.join(root,'scripts','run-tauri.mjs')).href).then(({runTauri})=>runTauri(process.argv.slice(1),{cwd:root,packageRoot:root})).then(({code,signal})=>{if(signal){process.kill(process.pid,signal);return;}process.exit(code??0);}).catch((error)=>{console.error(error instanceof Error?error.message:error);process.exit(1);});\" --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^0.563.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
